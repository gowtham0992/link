# Local editor/agent tooling
.claude/

# vhs demo render workspace
docs/media/.aha-demo/

# LinkBar build artifacts (never commit)
apps/LinkBar/.build/

# Build artifacts staged by mcp_package/hatch_build.py from the repo root
mcp_package/link_cli.py
mcp_package/serve.py
mcp_package/LINK.md
mcp_package/.linkignore
