CLAUDE.md
AGENTS.md
GEMINI.md
GEMINI.md
.cursor/
.kiro/
.github/copilot-instructions.md
.vscode/settings.json
.link-mcp-python

# PyPI build artifacts
mcp_package/dist/
mcp_package/*.egg-info/

# MCP registry auth tokens (personal credentials — never commit)
.mcpregistry_*
mcp_package/.mcpregistry_*

# Credential files
.env
.env.*
*.token
*.key
*.pem
*.p8
*.p12
id_rsa
id_ed25519
